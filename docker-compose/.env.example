# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=turismoindustrial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ─── API (.NET) ───────────────────────────────────────────────────────────────
# Development habilita Swagger em / na raiz; Production também habilita (Program.cs:65)
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ─── Painel (nginx) ───────────────────────────────────────────────────────────
# Frontend disponível em http://localhost:${PAINEL_PORT}
PAINEL_PORT=8081
