# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=turismoindustrial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ─── API (.NET) ───────────────────────────────────────────────────────────────
# Development habilita Swagger em / na raiz; Production também habilita (Program.cs:65)
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ─── Painel (nginx) ───────────────────────────────────────────────────────────
# Frontend disponível em http://localhost:${PAINEL_PORT}
PAINEL_PORT=8081

# ─── Auth admin (X-Api-Key) ───────────────────────────────────────────────────
# Chave esperada no header X-Api-Key dos endpoints de escrita. Sem esta variavel
# definida no .env, o docker-compose.yml usa o default
# `dev-api-key-checkin-industrial-2026` — funciona out-of-the-box mas qualquer
# desenvolvedor que clonar o repo conhece esse valor. Para forcar uma chave
# unica (geracao em docs/secrets-management.md), descomente e ajuste abaixo.
# AUTH_API_KEY=cole-uma-chave-de-32-hex-aqui

# ─── Google Maps (Places API) ─────────────────────────────────────────────────
# Chave server-side do GCP — NUNCA commitar valor real, manter aqui só o nome.
# Para usar, copie este arquivo para `.env` (gitignored) e cole sua chave.
# Sem chave, o stack sobe normalmente mas endpoints /api/empresas/import/google-maps
# retornam erro 500. Para gerar/rotacionar: ver docs/secrets-management.md.
GOOGLE_MAPS_API_KEY=
